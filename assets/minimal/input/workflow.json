{
  "version": 1,
  "stages": [
    {
      "id": "analysis",
      "inputs": [
        {
          "path": "input/data.tsv",
          "columns": [
            "id",
            "group",
            "value"
          ],
          "unique": [
            "id"
          ],
          "numeric": {
            "value": {
              "min": 0
            }
          },
          "min_rows": 1
        }
      ],
      "code": [
        "input/src/analysis.py"
      ],
      "params": {
        "scale": 1
      },
      "versions": {
        "python": [
          "{python}",
          "--version"
        ]
      },
      "command": [
        "{python}",
        "{root}/input/src/analysis.py"
      ],
      "outputs": [
        {
          "path": "summary.tsv",
          "columns": [
            "group",
            "n",
            "mean"
          ],
          "unique": [
            "group"
          ],
          "numeric": {
            "n": {
              "min": 1
            },
            "mean": {
              "min": 0
            }
          },
          "min_rows": 1
        }
      ]
    },
    {
      "id": "plot",
      "depends": [
        "analysis"
      ],
      "inputs": [
        {
          "path": "output/summary.tsv",
          "columns": [
            "group",
            "n",
            "mean"
          ],
          "unique": [
            "group"
          ],
          "numeric": {
            "n": {
              "min": 1
            },
            "mean": {
              "min": 0
            }
          },
          "min_rows": 1
        }
      ],
      "code": [
        "input/src/plot.py"
      ],
      "params": {
        "title": "Synthetic group means",
        "color": "#3568a8"
      },
      "command": [
        "{python}",
        "{root}/input/src/plot.py"
      ],
      "outputs": [
        {
          "path": "means.svg"
        }
      ]
    }
  ]
}
